# --- upstream / third-party repos (cloned separately) ---
/le-wm
/temporal-straightening
/Clone_Deterministic_Environment

# --- data ---
/.stable_worldmodel
/datasets
/data
/lewm-cus/data/
*.h5
*.csv

# --- weights & run outputs ---
*.pt
*.pth
*.pt.tmp
checkpoints/exp_*/
wandb/
outputs/

# --- experiment results (metrics, logs, plots, rollouts) ---
# Everything under checkpoints/ is ignored except the run configs,
# so how experiments are run stays tracked but their results do not.
/lewm-cus/checkpoints/**
!/lewm-cus/checkpoints/**/
!/lewm-cus/checkpoints/**/config.json
/lewm-cus/temp/
*.log
/rollout_*.png

# --- media ---
/videos
*.mp4

# --- python ---
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- editor / tooling ---
.claude/
.vscode/
.DS_Store
